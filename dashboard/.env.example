# Copy to .env.local (git-ignored) and set the same values in Vercel.

# --- Database (the stockradar Supabase project) ---
# Find both in Supabase under Connect. Replace [YOUR-PASSWORD] with the database password.
# URL-encode any symbols in the password (for example @ becomes %40).
# Transaction pooler (port 6543), used by the app at runtime.
# End it with ?sslmode=require&uselibpqcompat=true so the connection is encrypted.
DATABASE_URL=
# Session pooler (port 5432), used only by prisma migrate deploy.
# End it with ?schema=jobmatch&sslmode=require to keep the migration history out of "public".
DIRECT_URL=
# Never run prisma migrate dev or reset against this shared database.

# --- Auth ---
# Generate with: openssl rand -base64 32
AUTH_SECRET=
# The only account allowed in. It must be the primary email on your GitHub account.
AUTH_ALLOWED_EMAIL=you@example.com
# Your sign-in password, stored only as a hash. Set it with: npm run auth:set-password
AUTH_PASSWORD_HASH=

# --- LLM ---
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5

# --- Job sources ---
SOURCES_ENABLED=jsearch,gmail_alerts,adzuna,greenhouse
RAPIDAPI_KEY=
# Set this to your RapidAPI plan's monthly allowance. Searches are spread evenly across the month.
JSEARCH_MONTHLY_REQUEST_LIMIT=200
# The search runs each morning and evening. Each day gets about a 30th of the monthly allowance,
# so 4 per run leaves the evening run its share.
JSEARCH_MAX_REQUESTS_PER_RUN=4
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Comma-separated board tokens.
TARGET_COMPANIES_GREENHOUSE=

# --- Reading LinkedIn alerts: Gmail, read-only scope ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GMAIL_ALERT_LABEL=LinkedIn Alerts

# --- Daily email of new top matches, sent through Resend ---
RESEND_API_KEY=
# Leave empty to send it to AUTH_ALLOWED_EMAIL. Without a verified domain, Resend only delivers
# to the email your Resend account is registered with.
DIGEST_TO=
# The dashboard's web address, linked from the email. Use the same value for the DASHBOARD_URL repository secret.
DASHBOARD_URL=

# --- Scheduling and limits ---
CRON_SECRET=
