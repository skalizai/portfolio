# Copy to .env.local (git-ignored) and set the same values in Vercel.

# --- Database (Supabase) ---
# Pooled connection, used by the app at runtime.
DATABASE_URL=
# Direct connection, used only by prisma migrate.
DIRECT_URL=

# --- Auth ---
# Generate with: openssl rand -base64 32
AUTH_SECRET=
# The only account allowed in. It must be the primary email on your GitHub account.
AUTH_ALLOWED_EMAIL=you@example.com
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# --- LLM ---
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5

# --- Job sources ---
SOURCES_ENABLED=jsearch,gmail_alerts,adzuna,greenhouse
RAPIDAPI_KEY=
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Comma-separated board tokens.
TARGET_COMPANIES_GREENHOUSE=

# --- Reading LinkedIn alerts: Gmail, read-only scope ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GMAIL_ALERT_LABEL=LinkedIn Alerts

# --- Sending applications: Yahoo SMTP, using a Yahoo app password ---
SMTP_HOST=smtp.mail.yahoo.com
SMTP_PORT=465
SMTP_USER=
SMTP_APP_PASSWORD=

# --- Scheduling and limits ---
CRON_SECRET=
DAILY_APPLY_CAP=15
MIN_MATCH_SCORE=70
