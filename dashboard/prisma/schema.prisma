generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

// The connection URL lives in prisma.config.ts (migrations) and lib/db.ts (runtime).
// This database is shared with stockradar, whose tables are in "public". The job search stays
// in "jobmatch", investments in "finance" and Household & Family in "household".
datasource db {
  provider = "postgresql"
  schemas  = ["jobmatch", "finance", "household"]
}

enum ApplyChannel {
  EMAIL
  ATS_FORM
  LINKEDIN_EASY_APPLY
  COMPANY_SITE
  UNKNOWN

  @@schema("jobmatch")
}

enum Verdict {
  STRONG
  GOOD
  WEAK
  REJECT

  @@schema("jobmatch")
}

enum SeniorityFit {
  under
  fit
  over

  @@schema("jobmatch")
}

enum ApplicationStatus {
  DRAFT
  READY
  SUBMITTED
  OPENED_EXTERNALLY
  INTERVIEW
  OFFER
  REJECTED
  WITHDRAWN

  @@schema("jobmatch")
}

enum JobState {
  ACTIVE
  SAVED
  DISMISSED

  @@schema("jobmatch")
}

model Profile {
  id           String   @id @default(cuid())
  json         Json
  cvFileUrl    String?
  // Plain text of the latest CV. Generated applications may only use facts found here or in json.
  cvText       String?
  // The CV in sections, so that tailoring can only reorder what's already there.
  cvStructured Json?
  updatedAt    DateTime @updatedAt

  @@schema("jobmatch")
}

model Job {
  id             String       @id @default(cuid())
  source         String
  sourceJobId    String
  // Original board behind an aggregator (LinkedIn, Indeed, Bayt...), for the source chip.
  publisher      String?
  title          String
  company        String
  location       String?
  workMode       String?
  employmentType String?
  description    String
  url            String
  applyUrl       String?
  applyEmail     String?
  applyChannel   ApplyChannel @default(UNKNOWN)
  salaryMin      Int?
  salaryMax      Int?
  currency       String?
  postedAt       DateTime?
  fetchedAt      DateTime     @default(now())
  dedupeHash     String       @unique
  rawJson        Json?
  state          JobState     @default(ACTIVE)
  // When this job went out in the daily email, so it's only emailed once.
  notifiedAt     DateTime?

  scores      MatchScore[]
  application Application?
  auditLogs   AuditLog[]

  @@unique([source, sourceJobId])
  @@index([company, postedAt])
  @@index([state, postedAt])
  @@schema("jobmatch")
}

model MatchScore {
  id               String       @id @default(cuid())
  jobId            String
  job              Job          @relation(fields: [jobId], references: [id], onDelete: Cascade)
  score            Int
  verdict          Verdict
  matchedSkills    String[]
  missingSkills    String[]
  keyRequirements  String[]
  redFlags         String[]
  seniorityFit     SeniorityFit
  locationFit      Boolean
  reasoning        String
  modelVersion     String
  // Cache key: a job is re-scored only when the profile changes.
  profileUpdatedAt DateTime
  inputTokens      Int?
  outputTokens     Int?
  createdAt        DateTime     @default(now())

  @@unique([jobId, profileUpdatedAt, modelVersion])
  @@index([score])
  @@schema("jobmatch")
}

model Application {
  id             String            @id @default(cuid())
  // One application per job, enforced by the database rather than only in the UI.
  jobId          String            @unique
  job            Job               @relation(fields: [jobId], references: [id], onDelete: Restrict)
  status         ApplicationStatus @default(DRAFT)
  channel        ApplyChannel
  coverLetter    String?
  tailoredCvUrl  String?
  tailoredCv     Json?
  // Things for you to check, such as a name that isn't in your CV.
  draftWarnings  String[]          @default([])
  inputTokens    Int?
  outputTokens   Int?
  emailMessageId String?
  // Undo window: the send happens at this time unless it is cancelled first.
  sendAt         DateTime?
  submittedAt    DateTime?
  notes          String?
  // Snapshots of exactly what was sent, plus status transitions.
  history        Json              @default("[]")
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  auditLogs AuditLog[]

  @@index([status])
  @@index([sendAt])
  @@schema("jobmatch")
}

model SearchConfig {
  id               String   @id @default(cuid())
  keywords         String[]
  locations        String[]
  minScore         Int      @default(70)
  sourcesEnabled   String[]
  schedule         String   @default("0 */2 * * *")
  dailyApplyCap    Int      @default(15)
  scoreDailyCap    Int      @default(50)
  draftDailyCap    Int      @default(5)
  screeningAnswers Json     @default("{}")
  // Per-country rules, such as only keeping jobs that mention visa sponsorship. Null until saved.
  sponsorshipRules Json?
  updatedAt        DateTime @updatedAt

  @@schema("jobmatch")
}

/// Your sign-in password, once it's set from the Security page. Until then the AUTH_PASSWORD_HASH
/// setting is used. Only the hash is kept.
model Credential {
  id                String    @id @default("owner")
  passwordHash      String
  /// Sessions started before this are signed out, such as after a password change.
  sessionsValidFrom DateTime?
  updatedAt         DateTime  @updatedAt

  @@schema("jobmatch")
}

/// A six-digit code emailed to you to confirm a password change or reset. Only its hash is kept.
model VerificationCode {
  id        String    @id @default(cuid())
  purpose   String
  codeHash  String
  /// For a change, the new password's hash, applied once the code is confirmed.
  payload   Json?
  attempts  Int       @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([purpose, createdAt])
  @@schema("jobmatch")
}

model AuditLog {
  id            String       @id @default(cuid())
  action        String
  jobId         String?
  job           Job?         @relation(fields: [jobId], references: [id], onDelete: SetNull)
  applicationId String?
  application   Application? @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  payload       Json?
  at            DateTime     @default(now())

  @@index([action, at])
  @@schema("jobmatch")
}

// ---------------------------------------------------------------------------------------------
// Investments. Tracking only: nothing here can trade or move money, and no broker or bank
// usernames, passwords or account numbers are ever stored. Money and quantities are Decimal.
// ---------------------------------------------------------------------------------------------

enum AccountType {
  BROKERAGE
  BANK
  OTHER

  @@schema("finance")
}

enum AssetClass {
  STOCK
  ETF
  OTHER

  @@schema("finance")
}

enum PriceSource {
  FINNHUB
  MANUAL

  @@schema("finance")
}

enum TransactionType {
  BUY
  SELL
  DIVIDEND
  INTEREST
  DEPOSIT
  WITHDRAWAL
  FEE
  SPLIT

  @@schema("finance")
}

model Account {
  id           String        @id @default(cuid())
  name         String
  type         AccountType   @default(BROKERAGE)
  institution  String
  currency     String        @default("USD")
  isActive     Boolean       @default(true)
  notes        String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  transactions Transaction[]

  @@schema("finance")
}

model Instrument {
  id           String        @id @default(cuid())
  symbol       String        @unique
  name         String
  assetClass   AssetClass    @default(STOCK)
  exchange     String?
  currency     String        @default("USD")
  priceSource  PriceSource   @default(MANUAL)
  sector       String?
  region       String?
  createdAt    DateTime      @default(now())
  transactions Transaction[]
  prices       PriceQuote[]

  @@schema("finance")
}

model Transaction {
  id            String          @id @default(cuid())
  accountId     String
  account       Account         @relation(fields: [accountId], references: [id], onDelete: Restrict)
  instrumentId  String?
  instrument    Instrument?     @relation(fields: [instrumentId], references: [id], onDelete: Restrict)
  type          TransactionType
  date          DateTime        @db.Date
  // Shares for BUY and SELL, or the ratio for SPLIT, such as 4 for a 4-for-1 split.
  quantity      Decimal?        @db.Decimal(24, 8)
  price         Decimal?        @db.Decimal(24, 8)
  // Cash amount in the transaction currency, always positive. The type gives its direction.
  amount        Decimal         @db.Decimal(24, 8)
  fees          Decimal         @default(0) @db.Decimal(24, 8)
  currency      String
  // AED per one unit of the currency on the transaction date.
  fxRateToBase  Decimal         @db.Decimal(24, 10)
  notes         String?
  importBatchId String?
  createdAt     DateTime        @default(now())

  @@index([accountId, date])
  @@index([instrumentId, date])
  @@schema("finance")
}

model PriceQuote {
  id           String      @id @default(cuid())
  instrumentId String
  instrument   Instrument  @relation(fields: [instrumentId], references: [id], onDelete: Cascade)
  price        Decimal     @db.Decimal(24, 8)
  currency     String
  asOf         DateTime
  source       PriceSource
  createdAt    DateTime    @default(now())

  @@index([instrumentId, asOf])
  @@schema("finance")
}

model FxRate {
  id    String   @id @default(cuid())
  base  String
  quote String
  rate  Decimal  @db.Decimal(24, 10)
  asOf  DateTime @db.Date

  @@unique([base, quote, asOf])
  @@schema("finance")
}

// ---------------------------------------------------------------------------------------------
// Household & Family: household staff, advances, payroll, payslips, remittances home and other
// expenses. Money is Decimal, never a float. Rows marked isDemo come from "Load demo data" and
// are removed by "Clear demo data". Rows with deletedAt are hidden but kept for history.
// ---------------------------------------------------------------------------------------------

enum EmployeeStatus {
  ACTIVE
  ON_LEAVE
  LEFT

  @@schema("household")
}

enum StaffPaymentMethod {
  CASH
  BANK_TRANSFER

  @@schema("household")
}

enum AdvancePlan {
  ONE_TIME
  FIXED_MONTHLY
  CUSTOM

  @@schema("household")
}

enum AdvanceStatus {
  OPEN
  CLOSED

  @@schema("household")
}

enum InstallmentStatus {
  DUE
  PAID
  SKIPPED

  @@schema("household")
}

enum PayrollStatus {
  DRAFT
  APPROVED
  PAID

  @@schema("household")
}

enum Relationship {
  WIFE
  MOTHER
  FATHER
  SIBLING
  OTHER
  CHILD
  EMPLOYEE

  @@schema("household")
}

enum RemittancePurpose {
  HOUSEHOLD
  SCHOOL_FEES
  MEDICAL
  CONSTRUCTION
  SAVINGS
  OTHER

  @@schema("household")
}

enum ExpenseStatus {
  PENDING
  CONFIRMED

  @@schema("household")
}

enum DocumentType {
  CONTRACT
  CNIC
  CANTT_PASS
  OTHER

  @@schema("household")
}

/// One row only, with id "default".
model HouseholdSettings {
  id                String   @id @default("default")
  employerName      String   @default("My household")
  address           String   @default("")
  logoFileId        String?
  baseCurrency      String   @default("AED")
  secondaryCurrency String   @default("PKR")
  /// PKR per 1 AED, used to pre-fill a transfer. You enter the actual rate on each transfer.
  defaultPkrPerAed  Decimal  @default(75) @db.Decimal(18, 6)
  payrollDay        Int      @default(28)
  expiryAlertDays   Int      @default(60)
  updatedAt         DateTime @updatedAt

  @@schema("household")
}

/// Uploaded files, kept in the database (up to 5 MB each) and only served behind sign-in.
model StoredFile {
  id        String   @id @default(cuid())
  filename  String
  mimeType  String
  size      Int
  data      Bytes
  isDemo    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@schema("household")
}

model Employee {
  id               String              @id @default(cuid())
  fullName         String
  role             String
  nationality      String              @default("")
  photoFileId      String?
  phone            String              @default("")
  /// Pakistani national identity card, such as 35202-1234567-1.
  cnicNo           String              @default("")
  cnicExpiry       DateTime?           @db.Date
  /// Pass for entering a cantonment area.
  canttPassNo      String              @default("")
  canttPassExpiry  DateTime?           @db.Date
  joiningDate      DateTime            @db.Date
  contractStart    DateTime?           @db.Date
  contractEnd      DateTime?           @db.Date
  status           EmployeeStatus      @default(ACTIVE)
  /// In PKR, since the staff are in Pakistan. Allowances, advances and payroll are in PKR too.
  basicSalary      Decimal             @db.Decimal(18, 2)
  paymentMethod    StaffPaymentMethod  @default(CASH)
  bankName         String              @default("")
  iban             String              @default("")
  leaveDaysPerYear Int                 @default(30)
  notes            String              @default("")
  isDemo           Boolean             @default(false)
  deletedAt        DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  allowances       EmployeeAllowance[]
  documents        EmployeeDocument[]
  advances         Advance[]
  payrollLines     PayrollLine[]
  payslips         Payslip[]
  recipient        Recipient?

  @@schema("household")
}

model EmployeeAllowance {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  name       String
  amount     Decimal  @db.Decimal(18, 2)

  @@schema("household")
}

model EmployeeDocument {
  id         String       @id @default(cuid())
  employeeId String
  employee   Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  type       DocumentType
  fileId     String
  expiry     DateTime?    @db.Date
  createdAt  DateTime     @default(now())

  @@schema("household")
}

model Advance {
  id           String               @id @default(cuid())
  employeeId   String
  employee     Employee             @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  date         DateTime             @db.Date
  amount       Decimal              @db.Decimal(18, 2)
  reason       String               @default("")
  plan         AdvancePlan
  status       AdvanceStatus        @default(OPEN)
  isDemo       Boolean              @default(false)
  deletedAt    DateTime?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  installments AdvanceInstallment[]

  @@schema("household")
}

model AdvanceInstallment {
  id            String            @id @default(cuid())
  advanceId     String
  advance       Advance           @relation(fields: [advanceId], references: [id], onDelete: Cascade)
  /// "YYYY-MM": the payroll month it's due in.
  month         String
  amount        Decimal           @db.Decimal(18, 2)
  status        InstallmentStatus @default(DUE)
  note          String            @default("")
  payrollLineId String?
  paidAt        DateTime?

  @@index([month, status])
  @@schema("household")
}

model PayrollRun {
  id              String        @id @default(cuid())
  /// "YYYY-MM". One run per month.
  month           String        @unique
  status          PayrollStatus @default(DRAFT)
  approvedAt      DateTime?
  paidAt          DateTime?     @db.Date
  paidMethod      String        @default("")
  reference       String        @default("")
  totalGross      Decimal       @default(0) @db.Decimal(18, 2)
  totalDeductions Decimal       @default(0) @db.Decimal(18, 2)
  totalNet        Decimal       @default(0) @db.Decimal(18, 2)
  isDemo          Boolean       @default(false)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  lines           PayrollLine[]
  payslips        Payslip[]

  @@schema("household")
}

model PayrollLine {
  id              String     @id @default(cuid())
  runId           String
  run             PayrollRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  employeeId      String
  employee        Employee   @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  basic           Decimal    @db.Decimal(18, 2)
  /// [{ name, amount }] copied from the employee when the run was prepared.
  allowances      Json       @default("[]")
  /// [{ kind, label, amount }]: overtime, bonus, Eid gift, ticket allowance or other.
  earnings        Json       @default("[]")
  /// [{ kind, label, amount, installmentId? }]: advance installment, unpaid leave or other.
  deductions      Json       @default("[]")
  unpaidDays      Decimal    @default(0) @db.Decimal(6, 2)
  gross           Decimal    @db.Decimal(18, 2)
  totalDeductions Decimal    @db.Decimal(18, 2)
  net             Decimal    @db.Decimal(18, 2)

  @@unique([runId, employeeId])
  @@schema("household")
}

model Payslip {
  id         String     @id @default(cuid())
  runId      String
  run        PayrollRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  employeeId String
  employee   Employee   @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  /// Exactly what the payslip shows, frozen when the run was paid.
  snapshot   Json
  language   String     @default("en")
  createdAt  DateTime   @default(now())

  @@unique([runId, employeeId])
  @@schema("household")
}

model Recipient {
  id               String        @id @default(cuid())
  name             String
  relationship     Relationship  @default(OTHER)
  phone            String        @default("")
  account          String        @default("")
  wallet           String        @default("")
  city             String        @default("")
  notes            String        @default("")
  monthlyTargetAed Decimal?      @db.Decimal(18, 2)
  /// Set when the recipient is one of your family members or staff, whose name it follows.
  familyMemberId   String?       @unique
  familyMember     FamilyMember? @relation(fields: [familyMemberId], references: [id], onDelete: SetNull)
  employeeId       String?       @unique
  employee         Employee?     @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  isDemo           Boolean       @default(false)
  deletedAt        DateTime?
  createdAt        DateTime      @default(now())
  remittances      Remittance[]

  @@schema("household")
}

model Remittance {
  id            String            @id @default(cuid())
  date          DateTime          @db.Date
  recipientId   String
  recipient     Recipient         @relation(fields: [recipientId], references: [id], onDelete: Restrict)
  amountAed     Decimal           @db.Decimal(18, 2)
  /// PKR per 1 AED for this transfer.
  rate          Decimal           @db.Decimal(18, 6)
  amountPkr     Decimal           @db.Decimal(18, 2)
  feeAed        Decimal           @default(0) @db.Decimal(18, 2)
  channel       String            @default("")
  reference     String            @default("")
  purpose       RemittancePurpose @default(HOUSEHOLD)
  receiptFileId String?
  /// The family member's bank account it went to, when chosen.
  bankAccountId String?
  bankAccount   BankAccount?      @relation(fields: [bankAccountId], references: [id], onDelete: SetNull)
  notes         String            @default("")
  isDemo        Boolean           @default(false)
  deletedAt     DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([date])
  @@schema("household")
}

model ExpenseCategory {
  id               String             @id @default(cuid())
  name             String             @unique
  monthlyBudgetAed Decimal?           @db.Decimal(18, 2)
  sortOrder        Int                @default(0)
  isActive         Boolean            @default(true)
  expenses         Expense[]
  recurring        RecurringExpense[]

  @@schema("household")
}

model Expense {
  id            String          @id @default(cuid())
  date          DateTime        @db.Date
  categoryId    String
  category      ExpenseCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  amount        Decimal         @db.Decimal(18, 2)
  currency      String          @default("AED")
  /// AED per 1 unit of the currency (1 for AED).
  rateToAed     Decimal         @default(1) @db.Decimal(18, 8)
  amountAed     Decimal         @db.Decimal(18, 2)
  paymentMethod String          @default("")
  notes         String          @default("")
  receiptFileId String?
  status        ExpenseStatus   @default(CONFIRMED)
  recurringId   String?
  isDemo        Boolean         @default(false)
  deletedAt     DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([date])
  @@schema("household")
}

model RecurringExpense {
  id               String          @id @default(cuid())
  name             String
  categoryId       String
  category         ExpenseCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  amount           Decimal         @db.Decimal(18, 2)
  currency         String          @default("AED")
  dayOfMonth       Int             @default(1)
  isActive         Boolean         @default(true)
  /// "YYYY-MM" of the last pending expense created, so each month is created once.
  lastCreatedMonth String?
  isDemo           Boolean         @default(false)
  createdAt        DateTime        @default(now())

  @@schema("household")
}

model HouseholdAuditLog {
  id       String   @id @default(cuid())
  entity   String
  entityId String
  action   String
  before   Json?
  after    Json?
  at       DateTime @default(now())

  @@index([entity, entityId])
  @@index([at])
  @@schema("household")
}

enum FamilyRelationship {
  SELF
  WIFE
  SON
  DAUGHTER
  MOTHER
  FATHER
  BROTHER
  SISTER
  OTHER

  @@schema("household")
}

enum FamilyDocumentType {
  PASSPORT
  CNIC
  B_FORM
  EMIRATES_ID
  VISA
  BIRTH_CERTIFICATE
  NIKAH_NAMA
  OTHER

  @@schema("household")
}

/// You and your family: identity documents, with photos and copies.
model FamilyMember {
  id               String             @id @default(cuid())
  fullName         String
  relationship     FamilyRelationship
  dateOfBirth      DateTime?          @db.Date
  photoFileId      String?
  phone            String             @default("")
  email            String             @default("")
  city             String             @default("")
  bloodGroup       String             @default("")
  /// CNIC for adults, or the B-Form (CRC) number for children; 13 digits either way.
  cnicNo           String             @default("")
  cnicExpiry       DateTime?          @db.Date
  passportNo       String             @default("")
  passportIssued   DateTime?          @db.Date
  passportExpiry   DateTime?          @db.Date
  emiratesIdNo     String             @default("")
  emiratesIdExpiry DateTime?          @db.Date
  visaExpiry       DateTime?          @db.Date
  notes            String             @default("")
  isDemo           Boolean            @default(false)
  deletedAt        DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  documents        FamilyDocument[]
  bankAccounts     BankAccount[]
  recipient        Recipient?

  @@schema("household")
}

model FamilyDocument {
  id             String             @id @default(cuid())
  familyMemberId String
  familyMember   FamilyMember       @relation(fields: [familyMemberId], references: [id], onDelete: Cascade)
  type           FamilyDocumentType
  fileId         String
  expiry         DateTime?          @db.Date
  createdAt      DateTime           @default(now())

  @@schema("household")
}

/// A family member's bank account in Pakistan or the UAE, to choose when recording money sent.
model BankAccount {
  id             String       @id @default(cuid())
  familyMemberId String
  familyMember   FamilyMember @relation(fields: [familyMemberId], references: [id], onDelete: Cascade)
  bankName       String
  accountTitle   String       @default("")
  /// Account number or IBAN.
  accountNumber  String
  branch         String       @default("")
  isPrimary      Boolean      @default(false)
  isDemo         Boolean      @default(false)
  deletedAt      DateTime?
  createdAt      DateTime     @default(now())
  remittances    Remittance[]

  @@index([familyMemberId])
  @@schema("household")
}

/// How money is sent (an exchange house, a bank app), set up in Settings and chosen on each transfer.
model TransferChannel {
  id        String   @id @default(cuid())
  name      String   @unique
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@schema("household")
}
