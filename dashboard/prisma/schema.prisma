generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

// The connection URL lives in prisma.config.ts (migrations) and lib/db.ts (runtime).
// This database is shared with stockradar, whose tables are in "public". The job search stays
// in "jobmatch" and investments in "finance".
datasource db {
  provider = "postgresql"
  schemas  = ["jobmatch", "finance"]
}

enum ApplyChannel {
  EMAIL
  ATS_FORM
  LINKEDIN_EASY_APPLY
  COMPANY_SITE
  UNKNOWN

  @@schema("jobmatch")
}

enum Verdict {
  STRONG
  GOOD
  WEAK
  REJECT

  @@schema("jobmatch")
}

enum SeniorityFit {
  under
  fit
  over

  @@schema("jobmatch")
}

enum ApplicationStatus {
  DRAFT
  READY
  SUBMITTED
  OPENED_EXTERNALLY
  INTERVIEW
  OFFER
  REJECTED
  WITHDRAWN

  @@schema("jobmatch")
}

enum JobState {
  ACTIVE
  SAVED
  DISMISSED

  @@schema("jobmatch")
}

model Profile {
  id           String   @id @default(cuid())
  json         Json
  cvFileUrl    String?
  // Plain text of the latest CV. Generated applications may only use facts found here or in json.
  cvText       String?
  // The CV in sections, so that tailoring can only reorder what's already there.
  cvStructured Json?
  updatedAt    DateTime @updatedAt

  @@schema("jobmatch")
}

model Job {
  id             String       @id @default(cuid())
  source         String
  sourceJobId    String
  // Original board behind an aggregator (LinkedIn, Indeed, Bayt...), for the source chip.
  publisher      String?
  title          String
  company        String
  location       String?
  workMode       String?
  employmentType String?
  description    String
  url            String
  applyUrl       String?
  applyEmail     String?
  applyChannel   ApplyChannel @default(UNKNOWN)
  salaryMin      Int?
  salaryMax      Int?
  currency       String?
  postedAt       DateTime?
  fetchedAt      DateTime     @default(now())
  dedupeHash     String       @unique
  rawJson        Json?
  state          JobState     @default(ACTIVE)
  // When this job went out in the daily email, so it's only emailed once.
  notifiedAt     DateTime?

  scores      MatchScore[]
  application Application?
  auditLogs   AuditLog[]

  @@unique([source, sourceJobId])
  @@index([company, postedAt])
  @@index([state, postedAt])
  @@schema("jobmatch")
}

model MatchScore {
  id               String       @id @default(cuid())
  jobId            String
  job              Job          @relation(fields: [jobId], references: [id], onDelete: Cascade)
  score            Int
  verdict          Verdict
  matchedSkills    String[]
  missingSkills    String[]
  keyRequirements  String[]
  redFlags         String[]
  seniorityFit     SeniorityFit
  locationFit      Boolean
  reasoning        String
  modelVersion     String
  // Cache key: a job is re-scored only when the profile changes.
  profileUpdatedAt DateTime
  inputTokens      Int?
  outputTokens     Int?
  createdAt        DateTime     @default(now())

  @@unique([jobId, profileUpdatedAt, modelVersion])
  @@index([score])
  @@schema("jobmatch")
}

model Application {
  id             String            @id @default(cuid())
  // One application per job, enforced by the database rather than only in the UI.
  jobId          String            @unique
  job            Job               @relation(fields: [jobId], references: [id], onDelete: Restrict)
  status         ApplicationStatus @default(DRAFT)
  channel        ApplyChannel
  coverLetter    String?
  tailoredCvUrl  String?
  tailoredCv     Json?
  // Things for you to check, such as a name that isn't in your CV.
  draftWarnings  String[]          @default([])
  inputTokens    Int?
  outputTokens   Int?
  emailMessageId String?
  // Undo window: the send happens at this time unless it is cancelled first.
  sendAt         DateTime?
  submittedAt    DateTime?
  notes          String?
  // Snapshots of exactly what was sent, plus status transitions.
  history        Json              @default("[]")
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  auditLogs AuditLog[]

  @@index([status])
  @@index([sendAt])
  @@schema("jobmatch")
}

model SearchConfig {
  id               String   @id @default(cuid())
  keywords         String[]
  locations        String[]
  minScore         Int      @default(70)
  sourcesEnabled   String[]
  schedule         String   @default("0 */2 * * *")
  dailyApplyCap    Int      @default(15)
  scoreDailyCap    Int      @default(50)
  draftDailyCap    Int      @default(5)
  screeningAnswers Json     @default("{}")
  // Per-country rules, such as only keeping jobs that mention visa sponsorship. Null until saved.
  sponsorshipRules Json?
  updatedAt        DateTime @updatedAt

  @@schema("jobmatch")
}

model AuditLog {
  id            String       @id @default(cuid())
  action        String
  jobId         String?
  job           Job?         @relation(fields: [jobId], references: [id], onDelete: SetNull)
  applicationId String?
  application   Application? @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  payload       Json?
  at            DateTime     @default(now())

  @@index([action, at])
  @@schema("jobmatch")
}

// ---------------------------------------------------------------------------------------------
// Investments. Tracking only: nothing here can trade or move money, and no broker or bank
// usernames, passwords or account numbers are ever stored. Money and quantities are Decimal.
// ---------------------------------------------------------------------------------------------

enum AccountType {
  BROKERAGE
  BANK
  OTHER

  @@schema("finance")
}

enum AssetClass {
  STOCK
  ETF
  OTHER

  @@schema("finance")
}

enum PriceSource {
  FINNHUB
  MANUAL

  @@schema("finance")
}

enum TransactionType {
  BUY
  SELL
  DIVIDEND
  INTEREST
  DEPOSIT
  WITHDRAWAL
  FEE
  SPLIT

  @@schema("finance")
}

model Account {
  id           String        @id @default(cuid())
  name         String
  type         AccountType   @default(BROKERAGE)
  institution  String
  currency     String        @default("USD")
  isActive     Boolean       @default(true)
  notes        String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  transactions Transaction[]

  @@schema("finance")
}

model Instrument {
  id           String        @id @default(cuid())
  symbol       String        @unique
  name         String
  assetClass   AssetClass    @default(STOCK)
  exchange     String?
  currency     String        @default("USD")
  priceSource  PriceSource   @default(MANUAL)
  sector       String?
  region       String?
  createdAt    DateTime      @default(now())
  transactions Transaction[]
  prices       PriceQuote[]

  @@schema("finance")
}

model Transaction {
  id            String          @id @default(cuid())
  accountId     String
  account       Account         @relation(fields: [accountId], references: [id], onDelete: Restrict)
  instrumentId  String?
  instrument    Instrument?     @relation(fields: [instrumentId], references: [id], onDelete: Restrict)
  type          TransactionType
  date          DateTime        @db.Date
  // Shares for BUY and SELL, or the ratio for SPLIT, such as 4 for a 4-for-1 split.
  quantity      Decimal?        @db.Decimal(24, 8)
  price         Decimal?        @db.Decimal(24, 8)
  // Cash amount in the transaction currency, always positive. The type gives its direction.
  amount        Decimal         @db.Decimal(24, 8)
  fees          Decimal         @default(0) @db.Decimal(24, 8)
  currency      String
  // AED per one unit of the currency on the transaction date.
  fxRateToBase  Decimal         @db.Decimal(24, 10)
  notes         String?
  importBatchId String?
  createdAt     DateTime        @default(now())

  @@index([accountId, date])
  @@index([instrumentId, date])
  @@schema("finance")
}

model PriceQuote {
  id           String      @id @default(cuid())
  instrumentId String
  instrument   Instrument  @relation(fields: [instrumentId], references: [id], onDelete: Cascade)
  price        Decimal     @db.Decimal(24, 8)
  currency     String
  asOf         DateTime
  source       PriceSource
  createdAt    DateTime    @default(now())

  @@index([instrumentId, asOf])
  @@schema("finance")
}

model FxRate {
  id    String   @id @default(cuid())
  base  String
  quote String
  rate  Decimal  @db.Decimal(24, 10)
  asOf  DateTime @db.Date

  @@unique([base, quote, asOf])
  @@schema("finance")
}
